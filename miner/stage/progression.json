  "structures": {
    "$comment": "Loot a mod files under a structure's own namespace comes out of that structure whichever route you take — its chests, its crates, or a recipe made from what those hold — so the structure's gate is a floor under every one of them, never a way to make something earlier. Type-name prefix → the boss that opens it. SOTS's Planetarium chests need a Strange Key, which the Archaeologist only sells after The Advisor (its Planetarium Crate holds the same alloys and asks for nothing but Tardigrade bait, so the floor is what keeps that tier honest); its pyramid needs the evil boss.",
    "SOTS.Items.Pyramid.": { "after": "EaterOfWorlds", "via": "the pyramid" },
    "SOTS.Items.Planetarium.FromChests.": { "after": "TheAdvisorHead", "via": "a Planetarium chest (Strange Key)" }
  },
